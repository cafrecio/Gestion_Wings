@@ -1218,3 +1218,15 @@ @media (max-width: 768px) {
 
     .mobile-readable-card .info-value { flex: 1; min-width: 0; }
 }
+
+/* A7: listado de Alumnos, una tarjeta por fila (Carlos, 07/10/2026). */
+.alumnos-listado { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-card-gap); }
+.alumnos-listado > .alumno-card { min-width: 0; margin-bottom: 0; }
+.alumnos-listado .alumno-nombre { min-width: 0; overflow-wrap: anywhere; }
+.alumnos-listado .alumno-info { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.alumnos-listado .info-item { min-width: 0; align-items: flex-start; }
+.alumnos-listado .info-value { white-space: normal; overflow-wrap: anywhere; }
+.alumnos-listado .alumno-actions { border-top: 1px solid var(--color-border); padding-top: 0.75rem; }
+.alumnos-listado .empty-state { grid-column: 1 / -1; }
+@media (max-width: 1099px) { .alumnos-listado .alumno-info { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+@media (max-width: 480px) { .alumnos-listado .alumno-info { grid-template-columns: minmax(0, 1fr); } }
