{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Bash(php artisan *)",
      "Bash(git add *)",
      "Bash(C:/xampp/mysql/bin/mysql.exe:*)",
      "Bash(/c/xampp/mysql/bin/mysql.exe:*)",
      "Bash(cd /c/xampp/mysql/bin:*)",
      "Bash(php:*)",
      "Bash(php -r:*)",
      "Bash(php -l:*)",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cp:*)",
      "Bash(git:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); if printf '%s' \"$input\" | grep -q 'git commit'; then if git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then if [ \"$(git rev-list --count '@{u}..HEAD')\" -gt 0 ]; then git push 2>&1 | tail -2 || echo 'AVISO: el push fallo, hay commits sin subir'; fi; else echo 'AVISO: la rama no tiene remoto, no se pudo subir'; fi; fi",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
