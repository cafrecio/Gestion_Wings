{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Bash(php artisan *)",
      "Bash(git add *)",
      "Bash(C:/xampp/mysql/bin/mysql.exe:*)",
      "Bash(/c/xampp/mysql/bin/mysql.exe:*)",
      "Bash(cd /c/xampp/mysql/bin:*)",
      "Bash(php:*)",
      "Bash(php -r:*)",
      "Bash(php -l:*)",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cp:*)",
      "Bash(git:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "read -r line; cmd=$(echo \"$line\" | grep -o '\"command\":\"[^\"]*\"' | cut -d: -f2- | tr -d '\"'); if echo \"$cmd\" | grep -q 'git commit'; then git push; fi; if echo \"$cmd\" | grep -q 'git pull'; then \"C:/xampp/mysql/bin/mysql.exe\" -u root gestion_wings < database/dump.sql; fi",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
